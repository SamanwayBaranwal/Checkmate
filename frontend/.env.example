# Privy App ID (from privy.io dashboard)
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Railway backend URL (no trailing slash)
NEXT_PUBLIC_API_URL=https://your-backend.railway.app
NEXT_PUBLIC_WS_URL=https://your-backend.railway.app

# Public site URL (canonical links, sitemap, social share cards). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Free play (default) vs real money. Must match the backend REAL_MONEY. Leave unset for launch.
# NEXT_PUBLIC_REAL_MONEY=true
# Shown on the Terms and Privacy pages
NEXT_PUBLIC_CONTACT_EMAIL=support@your-domain.com
