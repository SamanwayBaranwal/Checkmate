# Database (auto-set by Railway if using their PostgreSQL service)
DATABASE_URL=postgresql://user:password@host:5432/checkmate

# Redis (auto-set by Railway if using their Redis service)
REDIS_URL=redis://default:password@host:6379

# Auth
JWT_SECRET=generate-a-long-random-string-here
# REQUIRED: logins are verified against this Privy app's public keys. Without it every login is rejected.
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
# Local development only: accept logins without a Privy token (ignored when NODE_ENV=production)
# AUTH_DEV_BYPASS=true

# Admin panel password (production refuses to boot if JWT_SECRET / ADMIN_SECRET / IDENTITY_SALT are under 24 chars)
ADMIN_SECRET=choose-a-strong-password
# User id that owns admin-created seasonal tournaments (POST /api/tournaments/seasonal)
SYSTEM_USER_ID=

# Frontend URL for CORS (your Vercel URL, comma-separated if multiple). In production only these exact origins
# are allowed; set ALLOW_VERCEL_PREVIEWS=true to also allow any *.vercel.app origin (not recommended).
FRONTEND_URL=https://your-app.vercel.app
# ALLOW_VERCEL_PREVIEWS=false

# Node
NODE_ENV=production
PORT=4000

# Crypto payments (leave blank to disable)
PLATFORM_WALLET_ADDRESS=
PLATFORM_WALLET_PRIVATE_KEY=
BASE_RPC_URL=
USDC_CONTRACT_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
PLATFORM_FEE_BPS=250

# Fair play (anti-cheat)
# Stockfish binary used to analyse every finished game (installed via nixpacks.toml on Railway)
STOCKFISH_PATH=stockfish
FAIRPLAY_DEPTH=12
FAIRPLAY_THREADS=1
# Withdrawal rules: minimum games played and minimum account age before the first withdrawal
MIN_GAMES_BEFORE_WITHDRAW=10
NEW_ACCOUNT_HOLD_HOURS=72

# Money safety (no KYC): locked winnings + stake limits by trust level
HOLD_HOURS=48                 # winnings stay locked this long AND until the game passes the fair-play check
MANUAL_APPROVAL_OVER=25       # a single win above this needs admin approval (Admin -> Payouts)
STAKE_NEW=5                   # max stake for new accounts
STAKE_TRUSTED=25              # after TRUSTED_GAMES clean games and TRUSTED_DAYS account age
TRUSTED_GAMES=20
TRUSTED_DAYS=7
STAKE_VERIFIED=100            # after VERIFIED_GAMES clean games and VERIFIED_DAYS account age
VERIFIED_GAMES=50
VERIFIED_DAYS=30
# One person, one account: accounts sharing a device never play each other. A shared IP also blocks pairing
# unless set to false (mobile carriers like Jio/Airtel put many strangers behind one IP).
PAIRING_BLOCK_SAME_IP=true
IDENTITY_SALT=another-long-random-string

# Rate limits are on automatically when NODE_ENV=production. Set RATE_LIMIT=1 to test them locally.
# RATE_LIMIT=1

# Real money: OFF unless "true". Free play = no deposits/withdrawals, credits have no cash value.
# Only enable after legal review for the countries you serve.
# REAL_MONEY=true
